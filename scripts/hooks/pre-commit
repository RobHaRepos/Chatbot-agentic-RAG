#!/usr/bin/env bash
set -euo pipefail

# Run the repository test suite. This uses pytest configuration in pytest.ini
echo "Running tests..."
python -m pytest -q --maxfail=1

echo "Generating coverage badge..."
# genbadge uses the coverage.xml as configured by pytest.ini
if command -v genbadge >/dev/null 2>&1; then
  genbadge coverage -i coverage.xml -o coverage.svg
else
  # Fallback to module invocation - this is recommended for virtualenv or Windows
  python -m genbadge coverage -i coverage.xml -o coverage.svg
fi

echo "Staging coverage.svg for commit..."
git add coverage.svg || true

echo "Pre-commit hook: tests passed and coverage badge created."
