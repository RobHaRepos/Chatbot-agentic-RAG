#!/usr/bin/env sh
# Cross-platform pre-commit hook wrapper
# Calls PowerShell hook when available, otherwise uses python directly.
HOOKDIR=$(dirname "$0")
PWSH=$(command -v pwsh || true)
POWERSHELL=$(command -v powershell || true)
if [ -n "$PWSH" ]; then
    exec "$PWSH" -NoProfile -ExecutionPolicy Bypass -File "$HOOKDIR/pre-commit.ps1" "$@"
elif [ -n "$POWERSHELL" ]; then
    exec "$POWERSHELL" -NoProfile -ExecutionPolicy Bypass -File "$HOOKDIR/pre-commit.ps1" "$@"
else
    # Fallback: use python in .venv if present or python from PATH
    if [ -x "$HOOKDIR/../.venv/bin/python" ]; then
        PYTHON="$HOOKDIR/../.venv/bin/python"
    elif command -v py >/dev/null 2>&1; then
        PYTHON="py -3"
    else
        PYTHON="python"
    fi
    echo "[pre-commit] Using PYTHON=$PYTHON"
    exec $PYTHON -m pytest -q --maxfail=1 --disable-warnings --cov=. --cov-report=xml:coverage.xml
fi
<#
PowerShell-only Git pre-commit hook. Designed for Windows users.
- Runs pytest with coverage to generate coverage.xml
- If genbadge is available, generates coverage.svg
#>

Write-Host "[pre-commit] Running pytest (generates coverage.xml)"

# Debug log — write a short entry so it's obvious the hook started even when an editor is involved
$logFile = Join-Path -Path (Resolve-Path -Path "$PSScriptRoot\.." -ErrorAction SilentlyContinue) -ChildPath "pre-commit.log"
try {
    "===== pre-commit hook started: $(Get-Date -Format o) - PID:$PID - User:$env:USERNAME" | Out-File -FilePath $logFile -Append -Encoding UTF8 -Force
    "GIT_EDITOR=$(git var GIT_EDITOR) core.hooksPath=$(git config --get core.hooksPath)" | Out-File -FilePath $logFile -Append -Encoding UTF8 -Force
} catch {
    Write-Warning "[pre-commit] unable to write to ${logFile}: ${_}"
}

# Prefer repository virtualenv python when available - this avoids running the system python without deps
$projectVenvWin = Join-Path -Path $PSScriptRoot -ChildPath "..\.venv\Scripts\python.exe" | Resolve-Path -ErrorAction SilentlyContinue
$projectVenvPosix = Join-Path -Path $PSScriptRoot -ChildPath "../.venv/bin/python" | Resolve-Path -ErrorAction SilentlyContinue

if ($projectVenvWin) {
    $PYTHON = $projectVenvWin -replace "\\`n",""
    # Attempt to activate the venv for the duration of the script so that PYTHONPATH and PATH are correct
    $activate = Join-Path -Path (Split-Path $PYTHON -Parent) -ChildPath "Activate.ps1"
    if (Test-Path $activate) {
        Write-Host "[pre-commit] Activating virtualenv via $activate"
        . $activate
    }
} elseif ($projectVenvPosix) {
    $PYTHON = $projectVenvPosix -replace "\\`n",""
} else {
    # Last-resort: try `py -3` then `python` on PATH
    if (Get-Command -Name py -ErrorAction SilentlyContinue) {
        $PYTHON = "py -3"
    } else {
        $PYTHON = "python"
    }
}

Write-Host "[pre-commit] Using python: $PYTHON"
try {
    & $PYTHON -m pytest -q --maxfail=1 --disable-warnings --cov=. --cov-report=xml:coverage.xml
}
catch {
    Write-Error "[pre-commit] pytest failed with error: $_"
    exit 1
}
if ($LASTEXITCODE -ne 0) {
    Write-Error "[pre-commit] pytest failed - aborting commit"
    exit $LASTEXITCODE
}

Write-Host "[pre-commit] pytest succeeded"

if (Get-Command -Name genbadge -ErrorAction SilentlyContinue) {
    Write-Host "[pre-commit] Generating coverage badge (coverage.svg)"
    genbadge coverage -i coverage.xml -o coverage.svg
    if ($LASTEXITCODE -ne 0) {
        Write-Error "[pre-commit] genbadge failed - aborting commit"
        exit $LASTEXITCODE
    }
    Write-Host "[pre-commit] coverage.svg updated"
    # Stage coverage badge so it is included with the current commit
    if (Get-Command -Name git -ErrorAction SilentlyContinue) {
        Write-Host "[pre-commit] Staging coverage.svg for commit"
        git add coverage.svg
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "[pre-commit] git add coverage.svg failed"
        }
    }
} else {
    Write-Warning "[pre-commit] genbadge not found - skipping badge generation"
    Write-Host "Install with: python -m pip install genbadge"
}

exit 0