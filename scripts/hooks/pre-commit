#!/usr/bin/env bash
# Git pre-commit hook: run pytest with coverage and, on success, update coverage badge

set -euo pipefail

if uname -s 2>/dev/null | grep -qiE "mingw|msys|cygwin"; then
  if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass "$(pwd)/scripts/hooks/pre-commit.ps1"
    exit $?
  elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -File "$(pwd)/scripts/hooks/pre-commit.ps1"
    exit $?
  fi
fi

echo "[pre-commit] Running pytest (generates coverage.xml)"
python -m pytest -q --maxfail=1 --disable-warnings --cov=. --cov-report=xml:coverage.xml

echo "[pre-commit] pytest succeeded"

if command -v genbadge >/dev/null 2>&1; then
  echo "[pre-commit] Generating coverage badge (coverage.svg)"
  genbadge coverage -i coverage.xml -o coverage.svg || {
    echo "[pre-commit] genbadge failed (non-zero exit code)" >&2
    exit 1
  }
  echo "[pre-commit] coverage.svg updated"
else
  echo "[pre-commit] genbadge not found in PATH - skipping coverage badge generation"
  echo "           Install with: python -m pip install genbadge"
fi

exit 0